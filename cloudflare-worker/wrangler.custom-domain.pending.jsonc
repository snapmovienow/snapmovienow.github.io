// Pending: do not deploy until the hostname belongs to an active Cloudflare zone.
{
  "name": "snapmovienow-edge",
  "main": "src/index.js",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": [
    "enable_request_signal"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "PLAYBACK_SESSIONS",
        "class_name": "PlaybackSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "playback-sessions-v1",
      "new_sqlite_classes": [
        "PlaybackSession"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  },
  "routes": [
    {
      "pattern": "api.snaptvnow.com",
      "custom_domain": true
    }
  ]
}
